{
  "extract_model": "deepseek-chat",
  "extract_every_n": 3,
  "extract_max_tokens": 800,
  "extract_retries": 2,
  "memory_mode": "layered",
  "kp_resolver": "open",
  "embedding_model_id": "BAAI/bge-large-zh-v1.5",
  "embedding_model_dir": "./models/bge-large-zh-v1.5",
  "embedding_device": "cuda:0",
  "embedding_use_fp16": true,
  "embedding_batch_size": 32,
  "soft_floor": 0.25,
  "retrieve_min_k": 1,
  "retrieve_context_turns": 2,
  "resolved_penalty": 0.55,
  "session_recency_boost": 0.08,
  "idle_flush_s": 600,
  "score_weights": {
    "dense": 0.55,
    "bm25": 0.2,
    "recency": 0.1,
    "reliability": 0.1,
    "unresolved": 0.05
  },
  "intent_proto_threshold": 0.3,
  "store_dir": "data/memory_online/store"
}
